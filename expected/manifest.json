{
  "site": "https://testbed.example",
  "note": "Ground truth for the planted-defect site. Every entry was written by hand from the comment in the page that plants it, not generated from a crawl. 'at_least' is used where a planted defect legitimately produces more than one finding (for example a missing title also lowers a score).",
  "pages": {
    "/missing-title.html": {
      "purpose": "No title, no meta description, no h1, heading levels skip h2->h4, image with no alt",
      "expect": [
        {
          "defect": "missing title"
        },
        {
          "defect": "missing meta description"
        },
        {
          "defect": "no h1 / heading hierarchy"
        },
        {
          "defect": "image without alt"
        }
      ]
    },
    "/long-meta.html": {
      "purpose": "Title and description both far past SERP display width",
      "expect": [
        {
          "defect": "title too long"
        },
        {
          "defect": "description too long"
        }
      ]
    },
    "/duplicate-a.html": {
      "purpose": "Shares title and description with duplicate-b; also has a broken internal link",
      "expect": [
        {
          "defect": "duplicate title across pages",
          "scope": "crawl"
        },
        {
          "defect": "duplicate description across pages",
          "scope": "crawl"
        },
        {
          "defect": "broken internal link",
          "scope": "crawl"
        }
      ]
    },
    "/duplicate-b.html": {
      "purpose": "Twin of duplicate-a",
      "expect": [
        {
          "defect": "duplicate title across pages",
          "scope": "crawl"
        },
        {
          "defect": "duplicate description across pages",
          "scope": "crawl"
        }
      ]
    },
    "/canonical-elsewhere.html": {
      "purpose": "Canonical points at /clean.html",
      "expect": [
        {
          "defect": "non-self-referencing canonical"
        }
      ]
    },
    "/broken-jsonld.html": {
      "purpose": "JSON-LD with a trailing comma",
      "expect": [
        {
          "defect": "unparseable structured data"
        }
      ]
    },
    "/no-lang.html": {
      "purpose": "No lang attribute, a nameless link, and an external target=_blank",
      "expect": [
        {
          "defect": "missing lang attribute"
        },
        {
          "defect": "link without accessible name"
        }
      ]
    },
    "/clean.html": {
      "purpose": "Negative control: nothing planted",
      "expect": []
    },
    "/viewport.html": {
      "purpose": "No viewport meta tag",
      "expect": [
        {
          "defect": "missing viewport meta tag"
        }
      ]
    },
    "/headings.html": {
      "purpose": "Two h1 elements and an empty heading",
      "expect": [
        {
          "defect": "multiple h1 headings"
        }
      ]
    },
    "/og-missing.html": {
      "purpose": "No Open Graph metadata (has Twitter)",
      "expect": [
        {
          "defect": "missing Open Graph tags"
        }
      ]
    },
    "/twitter-missing.html": {
      "purpose": "No Twitter card (has OG)",
      "expect": [
        {
          "defect": "missing twitter card"
        }
      ]
    },
    "/thin-content.html": {
      "purpose": "Title promises far more than the body delivers",
      "expect": [
        {
          "defect": "thin content"
        }
      ]
    },
    "/schema-product.html": {
      "purpose": "Product schema with no offer",
      "expect": [
        {
          "defect": "product schema missing offer"
        }
      ]
    },
    "/images-dimensions.html": {
      "purpose": "Three images with no width/height",
      "expect": [
        {
          "defect": "images without dimensions"
        }
      ]
    },
    "/links-external.html": {
      "purpose": "External link without rel, and an empty href",
      "expect": [
        {
          "defect": "external link without noopener"
        }
      ]
    },
    "/schema-local-business.html": {
      "purpose": "LocalBusiness with no address, telephone or hours",
      "expect": [
        {
          "defect": "local business missing address or telephone"
        },
        {
          "defect": "local business missing opening hours"
        }
      ]
    },
    "/schema-recipe.html": {
      "purpose": "Recipe with no ingredients, cook time or nutrition",
      "expect": [
        {
          "defect": "recipe missing ingredients"
        },
        {
          "defect": "recipe missing cook time or nutrition"
        }
      ]
    },
    "/schema-article.html": {
      "purpose": "Article with no author, headline or dates",
      "expect": [
        {
          "defect": "article missing author"
        },
        {
          "defect": "article missing dates"
        },
        {
          "defect": "article missing headline"
        }
      ]
    },
    "/schema-event.html": {
      "purpose": "Event with no location or start date",
      "expect": [
        {
          "defect": "event missing location"
        },
        {
          "defect": "event missing start date"
        }
      ]
    },
    "/client-rendered.html": {
      "purpose": "Body built by JavaScript; title rewritten",
      "expect": [
        {
          "defect": "content only exists after javascript runs"
        },
        {
          "defect": "links only exist after javascript runs"
        },
        {
          "defect": "structured data injected by javascript"
        },
        {
          "defect": "javascript rewrites the page title"
        }
      ]
    },
    "/guides/cookbook/deep-page.html": {
      "purpose": "Three levels deep, breadcrumb trail as plain text",
      "expect": [
        {
          "defect": "deep page missing breadcrumb structured data"
        }
      ]
    },
    "/hreflang.html": {
      "purpose": "Alternates with no x-default, no reciprocals, no self-reference",
      "expect": [
        {
          "defect": "hreflang missing x-default"
        },
        {
          "defect": "hreflang alternates missing reciprocal links"
        },
        {
          "defect": "hreflang missing self-reference"
        }
      ]
    },
    "/pagination.html": {
      "purpose": "Archive page whose only internal link is to itself",
      "expect": [
        {
          "defect": "archive page links only to itself"
        }
      ]
    },
    "/schema-faq.html": {
      "purpose": "FAQPage: one question, no accepted answer",
      "expect": [
        {
          "defect": "faq question missing accepted answer"
        },
        {
          "defect": "faq page has fewer than two questions"
        }
      ]
    },
    "/schema-jobposting.html": {
      "purpose": "JobPosting with no datePosted and no validThrough",
      "expect": [
        {
          "defect": "job posting missing datePosted"
        },
        {
          "defect": "job posting missing validThrough"
        }
      ]
    },
    "/schema-course.html": {
      "purpose": "Course with no provider",
      "expect": [
        {
          "defect": "course missing provider"
        }
      ]
    }
  }
}
